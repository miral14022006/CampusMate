# Multilingual College Assistant Environment Configuration

# Ports
CLIENT_PORT=5173
SERVER_PORT=5000
NLP_SERVICE_PORT=8000

# Service URLs
VITE_API_BASE_URL=http://localhost:5000/api
NLP_SERVICE_URL=http://localhost:8000

# Databases
MONGODB_URI=mongodb://localhost:27017/college_assistant
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=supersecret_jwt_key_change_in_production
TELEGRAM_BOT_TOKEN=optional_telegram_token_here

# NLP Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_LANGUAGE=en

