# CampusMate environment configuration.
# Copy to `.env` for Docker Compose / `run.sh`, and to `server/.env` when
# running the gateway directly with `node server.js` from the server folder.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
CLIENT_PORT=5173
SERVER_PORT=5000

# ---------------------------------------------------------------------------
# Service URLs
# The SPA calls the same-origin /api path; Vite and nginx proxy it to the gateway.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_GATEWAY_URL=http://localhost:5005

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/college_assistant
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth, sessions and security
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET must be at least 32 characters.
# JWT_SECRET is only used by the legacy admin fallback.
# ---------------------------------------------------------------------------
JWT_SECRET=supersecret_jwt_key_change_in_production
JWT_ACCESS_SECRET=supersecret_access_jwt_change_in_production_min_32_chars
JWT_REFRESH_SECRET=supersecret_refresh_jwt_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=pdeu.ac.in,campus.edu
SIGNUP_ENABLED=true
GUEST_MODE=true
SESSION_TTL_SECONDS=900
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Initial superadmin (used by scripts/seedSuperadmin.js).
# Rotate the password after the first login. Leave blank to skip seeding.
# ---------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@campus.edu
SUPERADMIN_PASSWORD=SuperAdmin@ComplexPass123!
SUPERADMIN_NAME=CampusMate Superadmin
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Legacy/default admin fallback (server/scripts/seedAdmin.js).
# ---------------------------------------------------------------------------
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=Admin@123
ADMIN_DEFAULT_EMAIL=admin@college.edu.in

# ---------------------------------------------------------------------------
# Analytics / activity
# ---------------------------------------------------------------------------
ACTIVITY_RETENTION_DAYS=90
DASHBOARD_CACHE_SECONDS=60
IP_HASH_SALT=random_salt_for_ip_hashing_in_audit_logs
# Set to true only after the institutional contact details are verified.
CAMPUS_CONTACTS_VERIFIED=false

# ---------------------------------------------------------------------------
# Optional SMTP email service for admin invites / password resets.
# Leave SMTP_HOST empty to log invite links instead of sending email.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusMate Admin" <no-reply@campus.edu>
EMAIL_RESET_ENABLED=false

# ---------------------------------------------------------------------------
# Feature 15: Google Calendar OAuth (optional, disabled by default).
# ---------------------------------------------------------------------------
FEATURE_CALENDAR_GOOGLE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
