# CampusMate NLP Service Configuration

APP_ENV=development
PORT=8000
HOST=0.0.0.0
NLP_API_KEY=campus_mate_secret_token_123

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Retrieval Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.0
TOP_K=4
CONFIDENCE_THRESHOLD=0.35
