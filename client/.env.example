# CampusMate frontend environment.
# Copy to `.env.local` for local development. All values are baked in at build time.

# Base path for the gateway. Defaults to /api (Vite dev proxy / nginx proxy).
VITE_API_BASE_URL=/api

# Vite dev proxy target for /api (the running Node gateway).
VITE_GATEWAY_URL=http://localhost:5000

# Optional dev proxy target for /nlp (direct FastAPI access).
# VITE_NLP_URL=http://localhost:8000

# Request timeout used by the fetch wrapper (milliseconds).
VITE_API_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Verified institutional contact details.
# Leave any value empty to hide that row in the UI; never fill in unverified
# contact data.
# ---------------------------------------------------------------------------
VITE_STUDENT_PORTAL_URL=
VITE_HELPDESK_EMAIL=
VITE_HELPDESK_PHONE=
VITE_HELPDESK_HOURS=
VITE_CAMPUS_ADDRESS=

# ---------------------------------------------------------------------------
# Feature flags. Flags default to enabled unless noted.
# ---------------------------------------------------------------------------
VITE_FEATURE_CALENDAR=true
VITE_FEATURE_CALENDAR_GOOGLE_OAUTH=false
VITE_FEATURE_SCENE_SNAP=false
