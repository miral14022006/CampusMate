# Multilingual College Assistant Environment Configuration

# Ports
CLIENT_PORT=5173
SERVER_PORT=5000
NLP_SERVICE_PORT=8000

# Service URLs
# The SPA uses a same-origin /api path; Vite proxies it to the gateway.
VITE_API_BASE_URL=/api
VITE_GATEWAY_URL=http://localhost:5000
NLP_SERVICE_URL=http://localhost:8000

# Databases
MONGODB_URI=mongodb+srv://formyself1402_db_user:StSzy54o02tM5RiL@cluster0.9zqzv86.mongodb.net/college_assistant?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=supersecret_jwt_key_change_in_production
TELEGRAM_BOT_TOKEN=optional_telegram_token_here

# Feature 15: Google Calendar OAuth (Optional, disabled by default)
FEATURE_CALENDAR_GOOGLE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# NLP Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_LANGUAGE=en
